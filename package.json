{
  "name": "deeper-maps",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side web app for visualising Deeper sonar scan data",
  "author": "Dave Page",
  "license": "PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyse": "tsx scripts/run-analysis.ts",
    "e2e": "playwright test",
    "build-e2e-fixture": "tsx scripts/build-e2e-fixture.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "d3-contour": "4.0.2",
    "fflate": "0.8.2",
    "idb": "8.0.3",
    "maplibre-gl": "4.7.1",
    "papaparse": "5.5.3",
    "polygon-clipping": "^0.15.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-contour": "3.0.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "20.19.39",
    "@types/papaparse": "5.5.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/web-worker": "2.1.9",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.5",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.59.2",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "2.1.9"
  }
